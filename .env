# HTTP port for the API server
PORT=3001

# Allowed frontend origin (CORS)
CORS_ORIGIN=http://localhost:3000

# Directory where session workspaces are stored
WORKSPACE_ROOT=/tmp/ide-workspaces

# Docker image used to run PHP
PHP_IMAGE=php:8.2-cli-alpine

# Max execution time before the container is killed (ms)
EXEC_TIMEOUT_MS=5000

# Container resource limits
CONTAINER_MEMORY=64m
CONTAINER_CPUS=0.5
PIDS_LIMIT=64

# Per-IP rate limit for /api/run (requests per minute)
RUN_RATE_LIMIT_MAX=10

# File / workspace size caps
MAX_FILE_SIZE_BYTES=524288
MAX_WORKSPACE_SIZE_BYTES=5242880
MAX_FILES_PER_SESSION=20
